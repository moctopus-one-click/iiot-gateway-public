# ─── Moctopus Gateway — Variables de entorno ────────────────────────────────
# Copia este archivo a .env y completa los valores antes de arrancar.

# Puerto en el que escucha el gateway en el host
# Cambiar si el puerto 3000 está ocupado
GATEWAY_PORT=3000

# Identificador único de esta instalación
# Usar algo descriptivo: nombre-planta, nombre-cliente, etc.
GATEWAY_ID=gateway-001

# JWT Secret — OBLIGATORIO cambiar antes de producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR-ESTE-VALOR-POR-UN-SECRETO-SEGURO

# URL desde donde acceden los operadores
# En red local: http://192.168.1.100:3000
# Con dominio: https://gateway.miplanta.com
URL_FRONTEND=http://localhost:3000
